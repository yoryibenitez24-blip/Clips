# ---------------------------------------------------------------- core
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://clips:clips@localhost:5432/clips
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- storage (local | s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
# S3-compatible (MinIO, R2, S3). With STORAGE_BACKEND=s3 the API returns presigned URLs.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=clips
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ---------------------------------------------------------------- working dirs
WORK_DIR=./data/work
UPLOAD_DIR=./data/uploads
WHISPER_CACHE_DIR=./data/models
# MUSIC_LIBRARY_DIR=./music          # folder of tracks you are licensed to use (enables the music mixer)
# LOCAL_MEDIA_DIR=./samples          # with LOCAL_FILE_INGEST_ENABLED=true, allows file:// sources (dev only)
LOCAL_FILE_INGEST_ENABLED=false

# ---------------------------------------------------------------- media acquisition policy
# YouTube media retrieval is DISABLED by default. YouTube's API Services Terms prohibit downloading
# or storing audiovisual content without prior written approval. Set "authorized" only when the
# deployment processes content you own, hold a licence for, or have YouTube's written approval for.
YOUTUBE_MEDIA_RETRIEVAL=disabled
# YOUTUBE_API_KEY=                     # Data API v3 key: accurate duration + channel verification (metadata only)
# YOUTUBE_ALLOWED_CHANNEL_IDS=UCxxxx   # optional: restrict retrieval to specific channels (needs the API key)
# YTDLP_COOKIES_FILE=./cookies.txt     # optional: your own account's cookies for your own content
DIRECT_URL_INGEST_ENABLED=true
UPLOAD_INGEST_ENABLED=true

# ---------------------------------------------------------------- limits & retention
MAX_SOURCE_DURATION_SECONDS=10800
MAX_SOURCE_BYTES=6442450944
MAX_UPLOAD_BYTES=4294967296
MAX_ACTIVE_ANALYSIS_JOBS=4
RATE_LIMIT_ANALYZE_PER_HOUR=10
SOURCE_RETENTION_HOURS=24
OUTPUT_RETENTION_DAYS=14

# ---------------------------------------------------------------- analysis
WHISPER_MODEL=small                   # tiny | base | small | medium | large-v3 (CPU int8 by default)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGES=en,es
TRANSCRIPTION_REQUIRED=false
SCENE_THRESHOLD=27
ANALYSIS_FPS=1
# ANTHROPIC_API_KEY=                   # enables LLM-assisted highlight ranking + titles
LLM_MODEL=claude-opus-5-5
LLM_HIGHLIGHT_SELECTION=true

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
